{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.capacity.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.capacity.description' | trans }}</div>
    <div class="block block--padded">
        {{ chart('capacity', {
            categories: groups,
            load: load,
            capacity: capacity,
        }, { format: { style: 'unit', unit: 'meter', decimals: 0 }, height: '20rem' }) }}
    </div>

    <h2>{{ '@page::section.forecast.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.forecast.description' | trans }}</div>
    <div class="block block--padded">
        {{ chart('forecast', {
            categories: months,
            actual: actual,
            forecast: forecast,
            low: low,
            high: high,
            today: today,
        }, { height: '20rem' }) }}
    </div>

    <h2>{{ '@page::section.sparkline.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.sparkline.description' | trans }}</div>
    {#- The last three months are the window a relaunch is decided on. -#}
    {{ data_table([
        { key: 'sku', label: '@page::column.sku' | trans, cell: 'code', width: 's' },
        { key: 'trend', label: '@page::column.orders' | trans, cell: 'html', width: 's' },
        { key: 'average', label: '@page::column.average' | trans, cell: 'number', digits: 1 },
        { key: 'available', label: '@page::column.available' | trans, cell: 'number', digits: 0 },
    ], items|map(item => {
        sku: item.sku,
        trend: chart_sparkline(item.orders, { active: [3, 5], label: '@page::column.orders' | trans }),
        average: item.average,
        available: item.available,
    }), {
        striped: true,
    }) }}

    <h2>{{ '@page::section.key_figures.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.key_figures.description' | trans }}</div>
    {#- A key figure of the design system, its trend under the value and its
        line over the period at its foot, as wide as the card. -#}
    <div class="grid">
        {%- for kpi in [
            { key: 'requests', value: '4 812', trend: '+12 %', way: 'up', points: [31, 34, 33, 38, 35, 40, 39, 42, 41, 44, 43, 47] },
            { key: 'sessions', value: '1 205', trend: '+3 %', way: 'up', points: [20, 22, 21, 21, 23, 22, 24, 23, 24, 25, 24, 25] },
            { key: 'errors', value: '17', trend: '−28 %', way: 'up', points: [30, 28, 31, 26, 25, 27, 22, 21, 20, 19, 18, 17] },
        ] -%}
            <div class="block block--card">
                <div class="block--figure block--figure--start">
                    <span class="block--figure-label">{{ ('@page::key_figure.' ~ kpi.key) | trans }}</span>
                    <span class="block--figure-value">{{ kpi.value }}</span>
                    <span class="block--figure-trend block--figure-trend--{{ kpi.way }}">{{ kpi.trend }}</span>
                    {{ chart_sparkline(kpi.points, { fluid: true, height: 28, label: ('@page::key_figure.' ~ kpi.key) | trans, class: 'block--figure-chart' }) }}
                </div>
            </div>
        {%- endfor -%}
    </div>
{%- endblock -%}
