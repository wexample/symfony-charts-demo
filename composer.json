{
  "name": "wexample/symfony-charts-demo",
  "description": "Demo pages of symfony-charts",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyChartsDemo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyChartsDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-charts": ">=1.0.3",
    "wexample/symfony-charts-ds": ">=1.0.1",
    "wexample/symfony-design-system": ">=31.0.0",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=21.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
